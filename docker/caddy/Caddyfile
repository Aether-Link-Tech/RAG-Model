# Public entry point for the local stack (FR-007 / AL-137).
# - https://localhost with a certificate from Caddy's local CA (`tls internal`)
# - TLS 1.3 only
# - http:// requests are redirected to https:// (Caddy automatic HTTPS)
# Trust the local CA once to remove the browser warning:
#   docker compose exec caddy caddy trust   (or import /data/caddy/pki/authorities/local/root.crt)
{
	admin off
	# Cloudflare Tunnel: cloudflared reaches Caddy from a private address and sends the real visitor IP
	# in CF-Connecting-IP. Only private (local) peers are trusted, and Caddy listens on 127.0.0.1 only
	# (docker-compose.yml), so nobody on the network can fake this header.
	servers {
		trusted_proxies static private_ranges
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

{$SITE_ADDRESS:localhost} {
	tls internal {
		protocols tls1.3
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	encode zstd gzip

	# The frontend container serves the app and proxies /api to the backend.
	reverse_proxy frontend:80 {
		# The real visitor IP (per-IP guest limits, audit log), not the tunnel's address.
		header_up X-Forwarded-For {client_ip}
		header_up X-Forwarded-Proto https
	}
}
