# Copy to frontend/.env
VITE_API_URL=/api/v1

# true = demo data (no backend), false = real backend
VITE_USE_MOCK=false

# Google reCAPTCHA v2 site key (FR-001/FR-002). Leave empty in local dev: a simple check is shown
# and the backend skips verification while RECAPTCHA_SECRET_KEY is unset.
VITE_RECAPTCHA_SITE_KEY=
