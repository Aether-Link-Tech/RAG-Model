# General
PROJECT_NAME="RAG-Model Enterprise AI"
ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# PostgreSQL (v17)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Privileged connection for Alembic migrations:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rag_db
MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rag_db
# Least-privilege non-superuser LOGIN role (`rag_app`) for runtime application queries:
APP_DB_USER=rag_app
APP_DB_PASSWORD=rag_app_dev_password
APP_DATABASE_URL=postgresql+asyncpg://rag_app:rag_app_dev_password@localhost:5432/rag_db

# Redis (v7.x)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Vector DB (ChromaDB)
CHROMA_HOST=localhost
CHROMA_PORT=8001
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=25
CLAMAV_QUARANTINE_DIR=quarantine
CHROMA_PERSIST_DIRECTORY=./chroma_data
CHROMA_PUBLIC_COLLECTION=public_knowledge
CHROMA_PRIVATE_COLLECTION_TEMPLATE=user_{user_id}_private
CHROMA_EMBEDDING_DIM=768

# AI / Models (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
# qwen2.5:3b: ~15 s per answer on CPU. qwen3:4b reasons at length (~5 min on CPU); use it only with a GPU.
LLM_MODEL=qwen2.5:3b
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_MODEL_VERSION=nomic-embed-text:v1.5
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_RETRIES=3
EMBEDDING_RETRY_BASE_DELAY=0.5
RERANKER_MODEL=bge-reranker-v2-m3
# Keyword search (FR-023): BM25 parameters and per-user index cache
BM25_K1=1.2
BM25_B=0.75
KEYWORD_INDEX_TTL_SECONDS=300
KEYWORD_INDEX_CACHE_SIZE=64

# Security & JWT Auth
SECRET_KEY=rag-secret-development-key-2026-auth-token-super-secure
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Auth (FR-001 / FR-002 / FR-003)
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12
LOGIN_CAPTCHA_AFTER_FAILURES=3
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Google reCAPTCHA v2 (secret key is server-side only; required outside development)
RECAPTCHA_ENABLED=True
RECAPTCHA_SECRET_KEY=
# Public site key for the frontend widget (docker compose build arg; for npm run dev use frontend/.env)
VITE_RECAPTCHA_SITE_KEY=

# Email verification. With SMTP_HOST empty in development, the link is logged instead.
EMAIL_VERIFICATION_EXPIRE_HOURS=24
EMAIL_VERIFICATION_URL=http://localhost:3000/verify-email
# docker compose only: the link in emails sent by the Docker stack (served through Caddy)
EMAIL_VERIFICATION_URL_DOCKER=https://localhost/verify-email
# Cloudflare Tunnel (docs/DEPLOY_TUNNEL.md): set the public address here, e.g. https://<name>.trycloudflare.com/verify-email
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@aether-link.local
SMTP_USE_TLS=True

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=26214400
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
# Token-based section-aware chunker (FR-016)
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=100

# Parser Sandbox (FR-067 / AL-163 / AL-164)
PARSER_SANDBOX_ENABLED=True
PARSER_DOCKER_IMAGE=rag-parser-sandbox:latest
PARSER_MEMORY_LIMIT=512m
PARSER_CPU_LIMIT=1.0
PARSER_TIMEOUT_SECONDS=60
PARSER_MAX_OUTPUT_BYTES=10485760
# stdin (default) = stream the file through stdin (-i) with no host bind-mount; mount = bind-mount file read-only
PARSER_INPUT_MODE=stdin

# --- FR-007 encryption at rest -------------------------------------------------------
# AES-256-GCM key for personal data (email, full name, audit IP) + HMAC key for email
# lookups. Required outside development. Generate each with:
#   python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
# Never change them on a database that already holds data (it would become unreadable).
PII_ENCRYPTION_KEY=
PII_INDEX_KEY=

# --- FR-069 security audit log -------------------------------------------------------
AUDIT_LOG_RETENTION_DAYS=90

# Network exposure: Caddy listens on 127.0.0.1 only (the public way in is Cloudflare Tunnel).
# Set PUBLIC_BIND=0.0.0.0 only on a server whose firewall allows 80/443 directly.
PUBLIC_BIND=127.0.0.1
# Guest questions on the landing page: per browser per day, and a safety ceiling per IP (shared Wi-Fi).
PUBLIC_ASK_PER_DAY=5
PUBLIC_ASK_PER_MINUTE=3
PUBLIC_ASK_PER_IP_DAY=150
PUBLIC_ASK_PER_IP_MINUTE=30
