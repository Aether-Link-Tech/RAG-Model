# General
PROJECT_NAME="RAG-Model Enterprise AI"
ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# PostgreSQL (v17)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Privileged connection for Alembic migrations:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rag_db
MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rag_db
# Least-privilege non-superuser LOGIN role (`rag_app`) for runtime application queries:
APP_DB_USER=rag_app
APP_DB_PASSWORD=rag_app_dev_password
APP_DATABASE_URL=postgresql+asyncpg://rag_app:rag_app_dev_password@localhost:5432/rag_db

# Redis (v7.x)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Vector DB (ChromaDB)
CHROMA_HOST=localhost
CHROMA_PORT=8001
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=25
CLAMAV_QUARANTINE_DIR=quarantine
CHROMA_PERSIST_DIRECTORY=./chroma_data
CHROMA_PUBLIC_COLLECTION=public_knowledge
CHROMA_PRIVATE_COLLECTION_TEMPLATE=user_{user_id}_private
CHROMA_EMBEDDING_DIM=768

# AI / Models (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3:4b
EMBEDDING_MODEL=nomic-embed-text
RERANKER_MODEL=bge-reranker-v2-m3

# Security & JWT Auth
SECRET_KEY=rag-secret-development-key-2026-auth-token-super-secure
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=26214400
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Parser Sandbox (FR-067 / AL-163 / AL-164)
PARSER_SANDBOX_ENABLED=True
PARSER_DOCKER_IMAGE=rag-parser-sandbox:latest
PARSER_MEMORY_LIMIT=512m
PARSER_CPU_LIMIT=1.0
PARSER_TIMEOUT_SECONDS=60
PARSER_MAX_OUTPUT_BYTES=10485760
# mount = backend on the host (bind-mount file read-only); stdin = backend in Docker (stream the file)
PARSER_INPUT_MODE=mount

# --- Sprint 1 security settings ---------------------------------------------------
# Access tokens are short-lived; the frontend renews them with the refresh token.
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# bcrypt cost factor (FR-007): must be >= 12 outside development
BCRYPT_ROUNDS=12

# AES-256-GCM key for personal data + HMAC key for email lookups (FR-007).
# Required outside development. Generate each with:
#   python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
# Never change them on a database that already holds data (it would be unreadable).
PII_ENCRYPTION_KEY=
PII_INDEX_KEY=

# Login protection (FR-002)
LOGIN_CAPTCHA_AFTER_FAILURES=3
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# Email verification (FR-001). Local dev: Mailpit, inbox at http://localhost:8025
FRONTEND_BASE_URL=http://localhost:3000
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_FROM=Aether Link <no-reply@aether-link.local>
EMAIL_VERIFICATION_TTL_HOURS=24

# Security audit log retention in days (FR-069)
AUDIT_LOG_RETENTION_DAYS=90
