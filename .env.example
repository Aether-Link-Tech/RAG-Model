# General
PROJECT_NAME="RAG-Model Enterprise AI"
ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# PostgreSQL (v17)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rag_db

# Redis (v7.x)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Vector DB (ChromaDB)
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIRECTORY=./chroma_data
CHROMA_PUBLIC_COLLECTION=public_knowledge
CHROMA_PRIVATE_COLLECTION_PREFIX=private_user_
CHROMA_EMBEDDING_DIM=768

# AI / Models (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3:4b
EMBEDDING_MODEL=nomic-embed-text
RERANKER_MODEL=bge-reranker-v2-m3

# Security & JWT Auth
SECRET_KEY=rag-secret-development-key-2026-auth-token-super-secure
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=26214400
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
